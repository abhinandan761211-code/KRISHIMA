# =============================================================================
# KRISHIMA — Backend (FastAPI) environment template
# Copy to backend/.env (git-ignored). SERVER-ONLY.
# NEVER commit this file, NEVER ship these values to a browser, never log them.
# Values are SAFE PLACEHOLDERS. Replace placeholders with real local values.
# =============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# One of: development | staging | production | test
APP_ENV=development
# Public base URL of the API (OpenAPI servers block, links in emails).
API_BASE_URL=http://localhost:8000
# Comma-separated browser origins allowed by CORS (frontend + admin dev origins).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Public app URL used for auth email redirects (must be in Supabase redirect allowlist).
APP_FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# PostgreSQL / Supabase  (SERVER-ONLY)
# ---------------------------------------------------------------------------
# RUNTIME DB URL. Least-privilege role subject to RLS. NOT the owner. NOT BYPASSRLS.
# Supabase: Project Settings -> Database -> Connection pooling (Transaction, port 6543)
# OR Session pooler. Runtime app uses the POOLED endpoint for hundreds of connections.
DATABASE_URL=postgresql+psycopg://app_runtime.PROJECT_REF:REPLACE_WITH_RUNTIME_DB_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
# MIGRATION DB URL. Higher-privilege credential used ONLY by Alembic (owner/postgres).
# Supabase: Project Settings -> Database -> Connection string (Session pooler / Direct).
# Never used by the API request path.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:REPLACE_WITH_DB_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# SQLAlchemy connection pool tuning (per API instance; keep small behind a pooler).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Supabase project (public URL + server-side admin API use).
SUPABASE_URL=https://PROJECT_REF.supabase.co
# SERVER-ONLY. Service-role key BYPASSES RLS. Used only for migrations/admin jobs/
# audit writing. Never sent to browser, never logged.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
# SERVER-ONLY. Supabase "publishable"/anon key is server-compatible for public
# reads (RLS-enforced) but the backend normally talks SQL directly. Optional.
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# ---------------------------------------------------------------------------
# JWT verification (Supabase Auth) — SERVER-ONLY
# ---------------------------------------------------------------------------
# Preferred: asymmetric signing (ES256/RS256). The API verifies tokens against JWKS.
# JWKS URL: https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Only set this if the project uses a SHARED HS256 secret (legacy). Leave EMPTY to
# force JWKS-only verification. The backend refuses HS256 when this is empty.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
# Comma-separated allowed algorithms. ES256 preferred; RS256 accepted.
SUPABASE_JWT_ALGORITHMS=ES256,RS256
# Seconds to cache the JWKS response before re-fetch.
JWKS_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Google OAuth (informational on the backend)
# ---------------------------------------------------------------------------
# Google OAuth is brokered by Supabase Auth. The Google Client ID/SECRET are set in
# the Supabase Dashboard (Authentication -> Providers -> Google), NOT here.
# The backend never needs the Google client secret. Do not add it to this file.
# This value is only used to build the frontend "Continue with Google" redirect.
SUPABASE_OAUTH_GOOGLE_ENABLED=true

# ---------------------------------------------------------------------------
# Supabase Storage (server-side signed URL generation)
# ---------------------------------------------------------------------------
SUPABASE_STORAGE_PUBLIC_BUCKET=public-assets
SUPABASE_STORAGE_PRIVATE_BUCKET=private-documents
MAX_UPLOAD_BYTES=10485760
# SERVER-ONLY. Secret used to sign short-lived internal URLs / upload grants.
SIGNING_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET

# ---------------------------------------------------------------------------
# Security & operations
# ---------------------------------------------------------------------------
# memory is acceptable for single-instance dev only. Use redis in staging/prod.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_DEFAULT_PER_MINUTE=60
# DEBUG | INFO | WARNING | ERROR (never DEBUG in production).
LOG_LEVEL=INFO
# Optional error tracking; leave empty to disable.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# External provider adapters (replaceable; noop = honestly "not configured")
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=noop
PAYMENT_PROVIDER_KEY_ID=
PAYMENT_PROVIDER_KEY_SECRET=
SMS_PROVIDER=noop
SMS_PROVIDER_KEY=
GEO_PROVIDER=noop
GEO_PROVIDER_KEY=
