# =============================================================================
# KRISHIMA — Database tooling environment template (Alembic / scripts)
# Copy to database/.env (git-ignored). SERVER-ONLY: contains DB credentials.
# =============================================================================

# MIGRATION DB URL — highest-privilege credential, used ONLY by Alembic/CLI scripts.
# Supabase: Project Settings -> Database -> Connection string (Session pooler on
# port 5432, or Direct connection if IPv6 is available).
# Use the SQLAlchemy driver form: postgresql+psycopg://user:pass@host:port/db
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:REPLACE_WITH_DB_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# READ-ONLY check URL used by database/scripts to verify connectivity without
# modifying anything. Usually the same as MIGRATION_DATABASE_URL or the runtime URL.
DATABASE_CHECK_URL=postgresql+psycopg://postgres.PROJECT_REF:REPLACE_WITH_DB_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Application schema name owned by Alembic (created in the first migration).
DB_SCHEMA=app
# Project environment label (development | staging | production).
APP_ENV=development
