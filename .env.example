# =============================================================================
# KRISHIMA — Environment template index (root)
# =============================================================================
# Each application has its OWN template. Copy the relevant one to `.env` in that
# directory. Real `.env` files are git-ignored at any depth and must never be
# committed. Values below are SAFE LOCAL PLACEHOLDERS only.
#
#   frontend/.env.example   -> frontend/.env    (browser; only VITE_* public values)
#   backend/.env.example    -> backend/.env     (server; all secrets live here)
#   admin/.env.example      -> admin/.env       (browser; only VITE_* public values)
#
# Credential rules (enforced, see SECURITY.md):
#   * Only intentionally-public config and publishable auth keys may appear in
#     frontend/admin environment variables (VITE_*).
#   * DB URLs, service-role keys, JWT secrets, signing secrets and provider API
#     secrets are SERVER-ONLY (backend).
#   * Never copy credentials from any other project (e.g. the old CenAGRI AI).
# =============================================================================

# ---------------------------------------------------------------------------
# Shared local development defaults (informational; do not put secrets here)
# ---------------------------------------------------------------------------
# Deployment environment for local work. One of: development | staging | production
APP_ENV=development
# Local Supabase endpoints (Supabase CLI default ports).
SUPABASE_LOCAL_API_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Backend API base URL used by frontend/admin during local development.
LOCAL_API_BASE_URL=http://localhost:8000/api/v1
# Browser origins allowed by backend CORS for local development.
LOCAL_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# NOTE: This root file intentionally contains NO credentials. Populate the
# per-application templates. See backend/.env.example for the server variables.
