# =============================================================================
# KRISHIMA — Frontend (browser) environment template
# Copy to frontend/.env.local (git-ignored). BROWSER-VISIBLE.
# Only intentionally-public configuration and PUBLISHABLE keys belong here.
# NEVER put DB URLs, service-role keys, JWT secrets, Google client secrets, or
# provider API secrets in VITE_* — they are compiled into the public bundle.
# =============================================================================

# Environment label. One of: development | staging | production
VITE_APP_ENV=development
# FastAPI backend base URL. All business operations go through the backend.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Supabase project URL (public).
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
# Supabase PUBLISHABLE key. Use the new publishable key (sb_publishable_...) or the
# legacy anon key. Both are public by design; RLS still enforces access.
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLISHABLE_OR_ANON_KEY
# Whether Google sign-in button is shown. Google OAuth is brokered by Supabase Auth.
VITE_ENABLE_GOOGLE_AUTH=true
# URL the auth provider redirects back to after OAuth / email confirmation.
# Must match an entry in Supabase Auth -> URL Configuration -> Redirect URLs.
VITE_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
# Confirmed public origin of the website (production only), e.g. https://krishima.in
# Leave blank until the domain is confirmed: with no value, no canonical tag is
# emitted and robots.txt disallows crawling. A production build REQUIRES this.
VITE_SITE_ORIGIN=
