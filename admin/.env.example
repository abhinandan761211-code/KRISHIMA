# =============================================================================
# KRISHIMA — Admin (browser) environment template
# Copy to admin/.env.local (git-ignored). BROWSER-VISIBLE.
# Same rules as frontend: only public config and publishable keys.
# Admin authorization is enforced by the BACKEND (staff roles + audit), never by
# any value in this file. Never put server secrets here.
# =============================================================================

VITE_APP_ENV=development
# Same FastAPI backend; admin calls are namespaced under /api/v1/admin/*.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Supabase project URL (public) and PUBLISHABLE key (auth only).
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLISHABLE_OR_ANON_KEY
# Auth callback for the admin app.
VITE_AUTH_CALLBACK_URL=http://localhost:5174/auth/callback
